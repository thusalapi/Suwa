# Suwa — local environment (clinic PC). Copy to .env and fill in. Never commit .env.

# PostgreSQL (local install on the clinic PC)
DATABASE_URL=postgresql://suwa:CHANGE_ME@localhost:5432/suwa

# Session signing secret (generate a long random string)
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# Default locale (English-only at launch): en
DEFAULT_LOCALE=en

# --- Backups (nightly pg_dump → encrypt → Google Drive). See docs/backups.md ---
# Passphrase for at-rest dump encryption (AES-256-GCM). REQUIRED to run backups; min 16 chars.
# Store a copy OFF the clinic PC too — without it, dumps cannot be restored.
BACKUP_ENCRYPTION_KEY=CHANGE_ME_LONG_RANDOM_STRING
# Local directory for encrypted dumps (created if missing). Default: backups
# BACKUP_DIR=backups
# rclone remote for off-site copies (optional — local-only if unset). e.g. gdrive:suwa-backups
# BACKUP_RCLONE_REMOTE=gdrive:suwa-backups
# How many local encrypted dumps to keep before pruning older ones. Default: 14
# BACKUP_KEEP=14

# --- End-to-end tests (Playwright). Optional — have defaults; override to change the isolated
#     test login created by `npm run seed:e2e`. The config loads .env so seed + tests stay in sync.
#     See e2e/README.md. NOT needed in production. ---
# E2E_EMAIL=e2e.owner@suwa.test
# E2E_PASSWORD=CHANGE_ME_STRONG
# E2E_SLOWMO=1000   # ms between actions in headed mode (0 = full speed)
# PORT=3000         # dev server port the tests target
