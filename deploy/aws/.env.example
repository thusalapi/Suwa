# Suwa production environment (EC2, docker compose). Copy to deploy/aws/.env (git-ignored) and
# fill in, or render it from AWS Secrets Manager. Never commit the real file.

# ── Database (RDS PostgreSQL, private subnet). sslmode=require: RDS connections are TLS.
DATABASE_URL=postgresql://suwa:CHANGE_ME@suwa-prod.xxxxxxxx.ap-south-1.rds.amazonaws.com:5432/suwa?sslmode=require
# Pool size per app instance (RDS max_connections must cover all instances + tools).
DATABASE_POOL_MAX=10

# ── App
SESSION_SECRET=CHANGE_ME_64_RANDOM_CHARS
DEFAULT_LOCALE=en
# The clinics' clock. Every "today", day boundary and printed time uses this zone — NOT the
# server's (EC2 runs on UTC).
APP_TIMEZONE=Asia/Colombo

# ── Tailscale (used by the tailscale container)
# Auth key from the admin console: tagged tag:suwa-app, pre-approved, one-off. Only needed for the
# first join; the node then keeps its identity in the tailscale-state volume.
TS_AUTHKEY=tskey-auth-CHANGE_ME
TS_HOSTNAME=suwa

# ── Backups (tools container; nightly via the systemd timer)
# Passphrase for AES-256-GCM dump encryption. ALSO keep a copy outside AWS — without it no dump
# can be restored.
BACKUP_ENCRYPTION_KEY=CHANGE_ME_LONG_RANDOM_STRING
BACKUP_KEEP=7
# Off-site copy to S3 through rclone, configured entirely by environment. Credentials come from
# the EC2 instance role (env_auth); the instance needs IMDSv2 hop limit 2 for containers.
BACKUP_RCLONE_REMOTE=s3:CHANGE_ME-suwa-backups/prod
RCLONE_CONFIG_S3_TYPE=s3
RCLONE_CONFIG_S3_PROVIDER=AWS
RCLONE_CONFIG_S3_ENV_AUTH=true
RCLONE_CONFIG_S3_REGION=ap-south-1
RCLONE_CONFIG_S3_SERVER_SIDE_ENCRYPTION=AES256

# ── Images (optional: pull prebuilt images from ECR instead of building on the instance)
# SUWA_APP_IMAGE=123456789012.dkr.ecr.ap-south-1.amazonaws.com/suwa-app:1.0.0
# SUWA_TOOLS_IMAGE=123456789012.dkr.ecr.ap-south-1.amazonaws.com/suwa-tools:1.0.0
