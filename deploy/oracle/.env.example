# Suwa pilot environment (single server, docker compose). Copy to deploy/oracle/.env
# (git-ignored), fill in, and `chmod 600 .env`. Never commit the real file.

# ── Database (PostgreSQL container on this server)
# Must be URL-safe because it goes into DATABASE_URL: generate with `openssl rand -hex 24`.
# Set it BEFORE the first `docker compose up` — it is baked into the data volume on first start.
POSTGRES_PASSWORD=CHANGE_ME_HEX
# Pool size for the app (the database allows 40 connections in total).
DATABASE_POOL_MAX=10

# ── App
# `openssl rand -base64 48`
SESSION_SECRET=CHANGE_ME_64_RANDOM_CHARS
DEFAULT_LOCALE=en
# The clinic's clock. Every "today", day boundary and printed time uses this zone — NOT the
# server's (which stays on UTC).
APP_TIMEZONE=Asia/Colombo

# ── Tailscale (used by the tailscale container)
# Auth key from the admin console: tagged tag:suwa-app, pre-approved, one-off. Only needed for the
# first join; the node then keeps its identity in the tailscale-state volume.
TS_AUTHKEY=tskey-auth-CHANGE_ME
TS_HOSTNAME=suwa

# ── Backups (tools container; nightly via the systemd timer)
# Passphrase for AES-256-GCM dump encryption (`openssl rand -base64 48`). Keep a copy OFF this
# server and outside Oracle — without it no dump can be restored.
BACKUP_ENCRYPTION_KEY=CHANGE_ME_LONG_RANDOM_STRING
BACKUP_KEEP=7

# Off-site copy through rclone, configured entirely by environment. On a single server this is
# NOT optional: the database and its local dumps share one disk.
#
# Option A — Oracle Object Storage (S3-compatible API; 20 GB free). Create a bucket and a
# "Customer Secret Key" for your user (Profile → Customer secret keys).
BACKUP_RCLONE_REMOTE=offsite:suwa-backups/pilot
RCLONE_CONFIG_OFFSITE_TYPE=s3
RCLONE_CONFIG_OFFSITE_PROVIDER=Other
RCLONE_CONFIG_OFFSITE_ENDPOINT=https://CHANGE_ME_NAMESPACE.compat.objectstorage.ap-mumbai-1.oraclecloud.com
RCLONE_CONFIG_OFFSITE_REGION=ap-mumbai-1
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=CHANGE_ME
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=CHANGE_ME
RCLONE_CONFIG_OFFSITE_FORCE_PATH_STYLE=true
#
# Option B — Cloudflare R2 (10 GB free). Better isolation: a different provider from the server.
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=Cloudflare
# RCLONE_CONFIG_OFFSITE_ENDPOINT=https://CHANGE_ME_ACCOUNT_ID.r2.cloudflarestorage.com
# RCLONE_CONFIG_OFFSITE_REGION=auto
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=CHANGE_ME
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=CHANGE_ME
